    "jose": "6.2.12",
    "pg": "8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
    "typescript": "7.0.2"
  }
}
