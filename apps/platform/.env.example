# Local development only. Use private Railway variables in production.
PLATFORM_ORIGIN=http://localhost:3000
# Empty by default. Explicit alternate HTTPS deployment origins only; never wildcards.
PLATFORM_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://platform:local-development-only@localhost:55432/a2aviary_platform
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-private-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-private-google-client-secret
PLATFORM_SUPERADMIN_EMAIL=owner@example.invalid
PLATFORM_TESTER_EMAILS=
OAUTH_ENABLE_DCR=false
PORT=3000
SITE_WORKFLOW_ENABLED=false
# Imported registration, release writes and first handoff are separate gates.
MANAGED_STATIC_SITES_ENABLED=false
MANAGED_STATIC_DEPLOY_ENABLED=false
MANAGED_STATIC_HANDOFF_ENABLED=false
SITE_AI_GAPS_ENABLED=false
# See docs/sites.md before setting these controller-only values.
# SITE_CREDENTIAL_KEY=
# OPENAI_API_KEY=
# RAILWAY_API_TOKEN=
# SITE_RAILWAY_WORKSPACE_ID=
# SITE_DEPLOY_ENVIRONMENT=fixture
# SITE_PROTECTED_PROJECT_IDS=
# SITE_PROTECTED_DOMAINS=
# SITE_BUCKET_ENDPOINT=
# SITE_BUCKET_NAME=
# SITE_BUCKET_REGION=
# SITE_BUCKET_ACCESS_KEY_ID=
# SITE_BUCKET_SECRET_ACCESS_KEY=
# SITE_BUCKET_FORCE_PATH_STYLE=true
# PB_BACKUP_ENDPOINT=
# PB_BACKUP_BUCKET=
# PB_BACKUP_REGION=
# PB_BACKUP_ACCESS_KEY_ID=
# PB_BACKUP_SECRET_ACCESS_KEY=
# PB_BACKUP_FORCE_PATH_STYLE=true
