# Local development only. Use private Railway variables in production.
PLATFORM_ORIGIN=http://localhost:3000
# Empty by default. Explicit alternate HTTPS deployment origins only; never wildcards.
PLATFORM_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://platform:local-development-only@localhost:55432/a2aviary_platform
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=replace-with-private-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-private-google-client-secret
PLATFORM_SUPERADMIN_EMAIL=owner@example.invalid
PLATFORM_TESTER_EMAILS=
OAUTH_ENABLE_DCR=false
PORT=3000
