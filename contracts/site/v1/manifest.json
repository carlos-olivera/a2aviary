  "changes": {
    "perMonth": {
      "value": 4,
      "rationale": "Selected bounded pilot allowance."
    },
    "calendar": {
      "value": "UTC",
      "rationale": "Unambiguous calendar-month boundary."
    },
    "rollover": {
      "value": false,
      "rationale": "Unused requests do not accumulate."
    },
    "countsWhen": {
      "value": "successfully-applied",
      "rationale": "Validation, rejected work and retries are not new applied requests."
    },
    "maxPagesTouched": {
      "value": 2,
      "rationale": "Selected per-request page cap."
    },
    "maxBlocksModified": {
      "value": 10,
      "rationale": "Selected per-request block cap; additions to new pages count."
    },
    "maxGlobalOperations": {
      "value": 1,
      "rationale": "Shared configuration has a separate allowance."
    },
    "maxOperations": {
      "value": 20,
      "rationale": "Bounds processing independently of final change size."
    },
    "operations": {
      "value": [
        "add-block",
        "update-block",
        "remove-block",
        "add-page",
        "update-page-seo",
        "update-tokens",
        "update-navigation"
      ],
      "rationale": "Typed bounded changes; no arbitrary patches, page deletion or renaming."
    },
    "doesNotCount": {
      "value": [
        "pocketbase-content-edit"
      ],
      "rationale": "Content-only CMS edits do not change the static site contract."
    }
  },
