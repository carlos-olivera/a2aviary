        },
        "fontBytes": {
          "value": 153600,
          "rationale": "Bound actual Latin WOFF2 bytes; do not gzip already-compressed fonts."
        },
        "components": {
          "value": 20,
          "rationale": "Keep the curated catalog understandable."
        },
        "variants": {
          "value": 40,
          "rationale": "Bound presentation choices."
        },
        "behaviors": {
          "value": 12,
          "rationale": "Bound reviewed executable surface."
        },
        "effects": {
          "value": 12,
          "rationale": "Bound decorative choices."
        },
        "fonts": {
          "value": 6,
          "rationale": "Bound curated font inventory."
        },
        "gzipLevel": {
          "value": 9,
          "rationale": "Deterministic gzip reference measurement; 1 KiB is 1024 bytes. JS is minified first."
        }
      }
    }
  },
  "changes": {
    "perMonth": {
      "value": 4,
      "rationale": "One successful edit deployment per request, owner-wide in the UTC calendar month of completion. Pending or unknown deployments hold capacity without counting as successful changes."
    },
    "calendar": {
      "value": "UTC",
      "rationale": "Unambiguous calendar-month boundary."
    },
    "rollover": {
      "value": false,
      "rationale": "Unused requests do not accumulate."
    },
    "countsWhen": {
      "value": "successfully-deployed-edit",
      "rationale": "Validation, rejected work and retries are not new applied requests."
    },
    "operations": {
      "value": [
        "draft-edit"
      ],
      "rationale": "Edit the live composition through revisioned drafts, full verification, browser approval and confirmed exact-byte deployment; the complete result obeys catalog and plan limits."
    },
    "doesNotCount": {
      "value": [
        "pocketbase-content-edit",
        "validation-failure",
        "quick-preview",
        "unapproved-snapshot",
        "retry",
        "initial-deployment"
      ],
      "rationale": "Content-only CMS edits do not change the static site contract."
    }
  },
  "schemas": {
    "site": "site-spec.schema.json"
