{
  "policyVersion": "2.3.0",
  "policySha256": "8b5993171557cdd2660390d929df8c51957aa758fc7ddf955d3b8be4e734fa32",
  "planId": "web-simple",
  "usage": {
    "status": "Prepared source only. Nothing is for sale; no live checkout or active Paddle merchant of record.",
    "submission": "Build a server draft incrementally through MCP. Upload bytes out of band through one agent/human upload session. Only server-normalized assets enter the spec.",
    "digest": "Hash compact UTF-8 JSON with recursively sorted object keys and preserved array order. Include the entire canonical spec. No Unicode normalization.",
    "approval": "A verified owner or enabled site administrator approves a verified server snapshot through the browser. Approval binds the spec and output hashes and draft revision. No MCP approval.",
    "previews": "Server-generated, sandbox-verified artifact and screenshots; deployment uses these exact bytes without rebuilding.",
    "changes": "Open a live edit draft; verify, approve in the browser and confirm deployment. One successful edit consumes one owner-wide monthly change. CMS record edits do not count.",
    "versions": "New drafts use policy 2.3.0 and contract 2.3. Existing 2.2.0 approved snapshots retain exact stored-byte deployment."
  },
  "includes": {
    "capabilities": {
      "value": [
        "static-astro",
        "pocketbase-cms"
      ],
      "rationale": "Owner-approved pilot architecture; no custom server code."
    },
    "maxPages": {
      "value": 7,
      "rationale": "Seven authored-page slots provide bounded headroom for a small catalog website."
    },
    "system404Counts": {
      "value": false,
      "rationale": "Generated system 404 is outside the authored-page allowance."
    },
    "ssl": {
      "value": true,
      "rationale": "Owner requires SSL with hosting; contract inclusion is not deployment evidence."
    },
    "domain": {
      "value": "client-supplied",
      "rationale": "Client brings their own domain; no domain sale."
    },
    "cmsCollections": {
      "value": [
        "catalog",
        "blog",
        "announcements"
      ],
      "rationale": "Only the three approved optional content collections."
    },
    "excludes": {
      "value": [
        "custom-backend",
        "end-user-auth",
        "checkout",
        "research",
        "ocr",
        "image-editing",
        "custom-script",
        "custom-style",
        "raw-html",
        "arbitrary-component",
        "uploaded-svg"
      ],
      "rationale": "Client-supplied scripts, styles and raw HTML remain excluded. Reviewed repository-authored behaviors are platform implementations, not client scripts."
    }
  },
  "firstVersion": {
    "contractVersion": {
      "value": "2.3",
      "rationale": "Server drafts with curated effects, behaviors and fonts; clients never supply code."
    },
    "structure": {
      "maxSectionsPerPage": {
        "value": 12,
        "rationale": "Bounded headroom for catalog landing sections."
      },
      "maxBlocksPerSection": {
        "value": 6,
        "rationale": "Bounded composable sections."
      },
      "maxBlocksPerPage": {
        "value": 30,
        "rationale": "Bounds aggregate page complexity."
      },
      "maxJsonBytes": {
        "value": 262144,
        "rationale": "Bounds parsing and validation work before semantic traversal."
      },
      "idPattern": {
        "value": "^[a-z][a-z0-9-]{0,63}$",
        "rationale": "Stable ASCII IDs; no path fragments or prototype keys."
      },
      "pagePathPattern": {
        "value": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/){0,3}$",
        "rationale": "Canonical trailing-slash routes with at most three safe segments."
      },
      "reservedPaths": {
        "value": [
          "/404/",
          "/assets/",
          "/api/"
        ],
        "rationale": "System error, asset and service namespaces cannot be authored pages."
      }
