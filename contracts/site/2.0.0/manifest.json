      },
      "pagePathPattern": {
        "value": "^/(?:[a-z0-9]+(?:-[a-z0-9]+)*/){0,3}$",
        "rationale": "Canonical trailing-slash routes with at most three safe segments."
      },
      "reservedPaths": {
        "value": [
