      },
      "digest": {
        "value": "sha256-sorted-json",
        "rationale": "Hashes the entire canonical spec; the immutable browser approval separately binds revision, actor, time and exact output hash."
      },
      "previewRequired": {
        "value": true,
        "rationale": "The server-produced verified snapshot and required screenshots must be reviewable before browser approval."
      }
