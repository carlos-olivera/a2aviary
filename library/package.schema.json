{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Curated library package",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "type": {
          "const": "component"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-zA-Z]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "heading",
                  "shortCopy",
                  "image",
                  "link",
                  "richText",
                  "textItems",
                  "linkItems",
                  "imageItems",
                  "faqItems",
                  "links",
                  "catalogCollection",
                  "blogCollection",
                  "announcementsCollection"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "required": [
              "kind",
              "required",
              "rationale"
            ]
          }
        },
        "requiresShellContent": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "version",
        "status",
        "fields"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "type": {
          "const": "variant"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "behaviors": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "root": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "control": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "each",
                    "tag"
                  ],
                  "properties": {
                    "each": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z]*$"
                    },
                    "tag": {
                      "const": "li"
                    }
                  }
                }
              ]
            },
            "action": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "helper",
                    "field"
                  ],
                  "properties": {
                    "helper": {
                      "const": "link"
                    },
                    "field": {
                      "type": "string",
                      "pattern": "^[a-z][a-zA-Z]*$"
                    }
                  }
                }
              ]
            },
            "status": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            },
            "messages": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
            }
          },
          "required": []
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "requiresShellContent": {
          "type": "boolean"
        },
        "contentRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fields"
            ],
            "properties": {
              "when": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z]*$"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-zA-Z]*$"
                }
              }
            }
          }
        }
      },
      "required": [
        "id",
        "type",
        "version",
        "status",
        "component",
        "variant",
        "behaviors"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "type": {
          "const": "effect"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "target": {
          "enum": [
            "section",
            "block",
            "items",
            "action"
          ]
        },
        "compatibility": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "requiresShellContent": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "version",
        "status",
        "target",
        "compatibility",
        "purpose"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "type": {
          "const": "behavior"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "requiresShellContent": {
          "type": "boolean"
        },
        "styleProperties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^--pkg-[a-z][a-z0-9-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit",
              "min",
              "max",
              "initial"
            ],
            "properties": {
              "unit": {
                "enum": [
                  "deg",
                  "px",
                  "%",
                  ""
                ]
              },
              "min": {
                "type": "number",
                "minimum": -999,
                "maximum": 999
              },
              "max": {
                "type": "number",
                "minimum": -999,
                "maximum": 999
              },
              "initial": {
                "type": "number",
                "minimum": -999,
                "maximum": 999
              }
            }
          }
        }
      },
      "required": [
        "id",
        "type",
        "version",
        "status",
        "purpose"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?::[a-z][a-z0-9]*(?:-[a-z0-9]+)*)?$"
        },
        "type": {
          "const": "font"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "family": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[A-Za-z][A-Za-z0-9]*(?: [A-Za-z0-9]+)*$"
        },
        "fallback": {
          "enum": [
            "sans-serif",
            "serif",
            "monospace"
          ]
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "package": {
              "type": "string",
              "pattern": "^@fontsource/[a-z0-9-]+$"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "license": {
              "const": "OFL-1.1"
            },
            "subset": {
              "const": "latin"
            }
          },
          "required": [
            "package",
            "version",
            "license",
            "subset"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^[a-z0-9-]+\\.woff2$"
              },
              "weight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "style": {
                "enum": [
                  "normal",
                  "italic"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "file",
              "weight",
              "style",
              "sha256"
            ]
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "requiresShellContent": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "version",
        "status",
        "family",
        "fallback",
        "source",
        "files",
        "purpose"
      ]
    }
  ]
}
