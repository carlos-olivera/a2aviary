{
  "name": "@a2aviary/generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "check": "npm run library:check && tsc --noEmit",
    "build": "npm run library:check:static && tsc --emitDeclarationOnly && node scripts/build.mjs",
    "test": "npm run library:check && node --test test/*.test.mjs",
    "fixture": "node scripts/fixture.mjs",
    "test:cms": "node scripts/test-cms.mjs",
    "test:cms:volume": "node --test scripts/test-cms-volume.mjs",
    "library:generate": "node scripts/library.mjs --write",
    "library:check": "node scripts/library.mjs",
    "library:check:static": "node scripts/library.mjs --static",
    "check:static": "npm run library:check:static && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@axe-core/playwright": "4.13.0",
    "ajv": "8.20.0",
    "astro": "7.3.6",
    "lighthouse": "13.5.0",
    "openai": "7.27.0",
    "playwright": "1.63.0",
    "sharp": "0.35.5",
    "@a2aviary/site-core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "acorn": "8.19.0",
    "esbuild": "0.25.12",
    "typescript": "7.0.2"
  }
}
